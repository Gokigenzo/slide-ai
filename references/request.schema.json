{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SlideRequestV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation",
    "project_dir",
    "source_files",
    "target_deck",
    "audience",
    "language",
    "usage",
    "slide_count",
    "duration_minutes",
    "style",
    "output_name",
    "research_enabled",
    "outline_path"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "operation": {
      "type": "string",
      "enum": [
        "create",
        "revise",
        "audit"
      ]
    },
    "project_dir": {
      "type": "string",
      "minLength": 1
    },
    "source_files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "role",
          "media_type"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "enum": [
              "content",
              "visual_reference"
            ]
          },
          "media_type": {
            "type": "string",
            "enum": [
              "pdf",
              "docx",
              "pptx",
              "png",
              "jpg",
              "jpeg",
              "txt",
              "md"
            ]
          }
        }
      }
    },
    "target_deck": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "audience": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "usage": {
      "type": "string",
      "enum": [
        "presentation_and_self_study"
      ]
    },
    "slide_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "duration_minutes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "style": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "academic_minimal",
        "technical_report",
        "creative",
        null
      ]
    },
    "output_name": {
      "type": "string",
      "minLength": 1
    },
    "research_enabled": {
      "type": "boolean"
    },
    "outline_path": {
      "type": "string",
      "minLength": 1
    }
  }
}
